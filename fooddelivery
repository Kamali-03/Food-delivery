<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Foodie - Food Delivery</title>

<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Arial,sans-serif}
body{background:#f7f8fc;color:#202532}
header{background:white;padding:18px 5%;display:flex;align-items:center;justify-content:space-between;gap:12px;box-shadow:0 2px 8px #ddd;position:sticky;top:0;z-index:5}
.logo{font-size:27px;font-weight:bold;color:#ff5722}
button{cursor:pointer;border:0;border-radius:8px;padding:11px 15px}
.orange{background:#ff5722;color:white;font-weight:bold}
.hero{padding:45px 7%;background:linear-gradient(120deg,#202532,#61321f);color:white}
.hero h1{font-size:clamp(28px,5vw,43px);margin-bottom:12px}
.hero h1 span{color:#ff7043}
.hero p{margin-bottom:20px}
.search{display:flex;max-width:500px;background:white;border-radius:8px;overflow:hidden}
.search input{flex:1;min-width:0;padding:14px;border:0;outline:none}
.search button{background:white}
main{max-width:1200px;width:92%;margin:30px auto}
.categories{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:28px}
.category{background:white;border:1px solid #ddd;border-radius:25px}
.category.active{background:#ff5722;color:white;border-color:#ff5722}
h2{margin-bottom:20px}
.menu{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}
.card{background:white;border-radius:13px;overflow:hidden;box-shadow:0 3px 12px #0000000c}
.food-art{height:175px;display:flex;justify-content:center;align-items:center;position:relative;overflow:hidden}
.food-art .food-emoji{font-size:95px;filter:drop-shadow(0 9px 5px #0003);transition:transform .2s}
.card:hover .food-emoji{transform:scale(1.1) rotate(-3deg)}
.food-art .art-label{position:absolute;bottom:10px;left:12px;background:#ffffffdd;border-radius:20px;padding:5px 10px;font-size:12px}
.heart{position:absolute;right:10px;top:10px;background:white;border-radius:50%;font-size:18px;padding:7px}
.card-content{padding:15px}
.card-content h3{margin-bottom:8px}
.description{font-size:13px;color:#777;min-height:32px;line-height:1.5}
.tag{display:inline-block;background:#fff0e9;color:#e64a19;padding:5px 9px;border-radius:20px;font-size:12px;margin-top:8px}
.bottom{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:14px}
.price{font-size:20px;font-weight:bold}
.add{background:#ff5722;color:white;font-weight:bold}
.empty{text-align:center;padding:35px;background:white;border-radius:10px;grid-column:1/-1}
.overlay{display:none;position:fixed;inset:0;background:#0007;z-index:9}
.overlay.show{display:block}
.cart{position:fixed;top:0;right:-440px;width:400px;max-width:95%;height:100dvh;background:white;z-index:10;display:flex;flex-direction:column;transition:right .25s;box-shadow:-5px 0 20px #0002}
.cart.open{right:0}
.cart-head{padding:20px;display:flex;justify-content:space-between;border-bottom:1px solid #eee}
.close{font-size:25px;background:transparent;padding:0 8px}
.cart-items{padding:15px;overflow:auto;flex:1}
.cart-item{display:flex;gap:12px;padding:13px 0;border-bottom:1px solid #eee}
.mini-art{width:65px;height:65px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:36px;flex-shrink:0}
.item-info{flex:1}
.item-info h4{margin:5px 0}
.qty{display:flex;align-items:center;gap:12px;margin-top:9px}
.qty button{background:#eee;padding:5px 10px}
.remove{color:#d32f2f;background:white;padding:5px 0;font-size:12px}
.cart-footer{padding:20px;border-top:1px solid #eee}
.total{display:flex;justify-content:space-between;font-size:20px;font-weight:bold;margin-bottom:15px}
.checkout{width:100%;background:#ff5722;color:white;font-weight:bold}
.modal{display:none;position:fixed;inset:0;z-index:20;background:#0008;align-items:center;justify-content:center;padding:15px}
.modal.show{display:flex}
.modal-box{background:white;border-radius:13px;padding:24px;width:100%;max-width:440px;max-height:90dvh;overflow:auto}
.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
.field{margin-bottom:14px}
.field label{display:block;font-weight:bold;font-size:14px;margin-bottom:7px}
.field input,.field textarea,.field select{width:100%;padding:12px;border:1px solid #ccc;border-radius:7px}
.field textarea{height:80px;resize:vertical}
.submit{width:100%;background:#ff5722;color:white;font-weight:bold;margin-top:8px}
.success{text-align:center;line-height:1.8}
.success-icon{font-size:60px}
.success h2{color:#218c50;margin:10px 0}
footer{background:#202532;color:white;text-align:center;padding:25px;margin-top:40px}
footer p{color:#ddd;margin-top:8px}
@media(max-width:500px){
 header{padding:14px 4%}.logo{font-size:22px}
 .hero{padding:35px 5%}
 .menu{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
 .food-art{height:130px}.food-art .food-emoji{font-size:70px}
 .card-content{padding:11px}.card-content h3{font-size:15px}
 .description{font-size:12px}.bottom{align-items:flex-start;flex-direction:column}
 .add{width:100%}
}
</style>
</head>

<body>

<header>
  <div class="logo">🍴 Foodie</div>
  <button class="orange" id="openCart">🛒 Cart (<span id="count">0</span>)</button>
</header>

<section class="hero">
  <h1>Delicious Food<br><span>Delivered to Your Door!</span></h1>
  <p>Fresh • Tasty • Fast</p>
  <button class="orange" onclick="document.getElementById('menu').scrollIntoView({behavior:'smooth'})">Order Now →</button>
  <div class="search" style="margin-top:20px">
    <input id="search" placeholder="Search pizza, biryani, dosa...">
    <button id="clearSearch">✕</button>
  </div>
</section>

<main id="menu">
  <div class="categories">
    <button class="category active" data-cat="All">All</button>
    <button class="category" data-cat="Pizza">🍕 Pizza</button>
    <button class="category" data-cat="Biryani">🍚 Biryani</button>
    <button class="category" data-cat="Burgers">🍔 Burgers</button>
    <button class="category" data-cat="South Indian">🥞 South Indian</button>
    <button class="category" data-cat="Drinks">🥤 Drinks</button>
  </div>

  <h2 id="menuTitle">Popular Dishes</h2>
  <div class="menu" id="foodMenu"></div>
</main>

<div class="overlay" id="overlay"></div>

<aside class="cart" id="cart">
  <div class="cart-head">
    <h2 style="margin:0">🛒 Your Cart</h2>
    <button class="close" id="closeCart">×</button>
  </div>
  <div class="cart-items" id="cartItems"></div>
  <div class="cart-footer">
    <div class="total"><span>Total</span><span id="total">₹0</span></div>
    <button class="checkout" id="checkout">Proceed to Checkout</button>
  </div>
</aside>

<div class="modal" id="modal">
  <div class="modal-box">
    <div id="formSection">
      <div class="modal-head">
        <h2 style="margin:0">Delivery Details</h2>
        <button class="close" id="closeModal">×</button>
      </div>
      <form id="orderForm">
        <div class="field">
          <label for="customer">Full Name</label>
          <input id="customer" required maxlength="100" placeholder="Enter your name">
        </div>
        <div class="field">
          <label for="phone">Phone Number</label>
          <input id="phone" required inputmode="numeric" pattern="[0-9]{10}" maxlength="10" placeholder="10-digit mobile number">
        </div>
        <div class="field">
          <label for="address">Delivery Address</label>
          <textarea id="address" required placeholder="Enter your address"></textarea>
        </div>
        <div class="field">
          <label for="payment">Payment Method</label>
          <select id="payment">
            <option>Cash on Delivery</option>
            <option>UPI (Demo)</option>
            <option>Card (Demo)</option>
          </select>
        </div>
        <div class="total"><span>Order Total</span><span id="checkoutTotal">₹0</span></div>
        <button class="submit" type="submit">Place Order</button>
      </form>
    </div>
    <div id="successSection" hidden></div>
  </div>
</div>

<footer>
  <h2>🍴 Foodie</h2>
  <p>Fresh Food. Fast Delivery. Happy You!</p>
  <p>© 2026 Foodie Demo</p>
</footer>

<script>
const foods = [
 {id:1,name:"Margherita Pizza",cat:"Pizza",price:220,emoji:"🍕",bg:"#ffe0c7",desc:"Cheesy pizza with fresh tomatoes."},
 {id:2,name:"Chicken Biryani",cat:"Biryani",price:180,emoji:"🍛",bg:"#ffe5a3",desc:"Aromatic rice with delicious spices."},
 {id:3,name:"Masala Dosa",cat:"South Indian",price:80,emoji:"🥞",bg:"#fff0bd",desc:"Crispy dosa served with chutney."},
 {id:4,name:"Cheese Burger",cat:"Burgers",price:150,emoji:"🍔",bg:"#f9dfb8",desc:"Juicy burger with cheese and vegetables."},
 {id:5,name:"Idli and Sambar",cat:"South Indian",price:60,emoji:"🍘",bg:"#e3f2d4",desc:"Soft idlis with hot sambar."},
 {id:6,name:"Cold Coffee",cat:"Drinks",price:90,emoji:"🥤",bg:"#ead8c7",desc:"Refreshing chilled coffee."},
 {id:7,name:"Pepperoni Pizza",cat:"Pizza",price:280,emoji:"🍕",bg:"#ffd5c1",desc:"Pizza with cheese and toppings."},
 {id:8,name:"Veg Burger",cat:"Burgers",price:110,emoji:"🍔",bg:"#f4e0b9",desc:"Crispy vegetable burger."},
 {id:9,name:"Veg Biryani",cat:"Biryani",price:140,emoji:"🍚",bg:"#f9e8b3",desc:"Flavourful vegetable biryani."},
 {id:10,name:"Orange Juice",cat:"Drinks",price:70,emoji:"🍹",bg:"#ffe0a5",desc:"Fresh and refreshing juice."},
 {id:11,name:"Paneer Dosa",cat:"South Indian",price:120,emoji:"🥞",bg:"#f9e7bd",desc:"Golden dosa with tasty filling."},
 {id:12,name:"French Fries",cat:"Burgers",price:90,emoji:"🍟",bg:"#ffe8a5",desc:"Crispy golden fries."}
];

let category="All";
let favorites=new Set();
let cart=loadCart();

function loadCart(){
 try{
  const data=JSON.parse(localStorage.getItem("foodieCart")||"[]");
  if(!Array.isArray(data))return [];
  return data.filter(x=>foods.some(f=>f.id===x.id)&&Number.isInteger(x.qty)&&x.qty>0&&x.qty<=99);
 }catch(e){return []}
}

function money(n){return "₹"+n.toLocaleString("en-IN")}

function renderMenu(){
 const query=document.getElementById("search").value.trim().toLowerCase();
 const list=foods.filter(f=>(category==="All"||f.cat===category)&&
 (f.name.toLowerCase().includes(query)||f.desc.toLowerCase().includes(query)));
 const root=document.getElementById("foodMenu");
 root.replaceChildren();
 document.getElementById("menuTitle").textContent=category==="All"?"Popular Dishes":category+" Menu";

 if(!list.length){
  root.innerHTML='<div class="empty">😔<h3>No food found</h3><p>Try another search.</p></div>';
  return;
 }

 list.forEach(f=>{
  const card=document.createElement("article");
  card.className="card";

  // Built-in CSS food illustration: no external image URL needed.
  const art=document.createElement("div");
  art.className="food-art";
  art.style.background=f.bg;

  const emoji=document.createElement("span");
  emoji.className="food-emoji";
  emoji.textContent=f.emoji;

  const label=document.createElement("span");
  label.className="art-label";
  label.textContent=f.cat;

  const heart=document.createElement("button");
  heart.className="heart";
  heart.textContent=favorites.has(f.id)?"❤️":"🤍";
  heart.setAttribute("aria-label","Toggle favourite");
  heart.onclick=()=>{
   favorites.has(f.id)?favorites.delete(f.id):favorites.add(f.id);
   renderMenu();
  };

  art.append(emoji,label,heart);

  const content=document.createElement("div");
  content.className="card-content";

  const name=document.createElement("h3");
  name.textContent=f.name;

  const desc=document.createElement("p");
  desc.className="description";
  desc.textContent=f.desc;

  const tag=document.createElement("span");
  tag.className="tag";
  tag.textContent=f.cat;

  const bottom=document.createElement("div");
  bottom.className="bottom";

  const price=document.createElement("span");
  price.className="price";
  price.textContent=money(f.price);

  const add=document.createElement("button");
  add.className="add";
  add.textContent="+ Add to Cart";
  add.onclick=()=>addCart(f.id);

  bottom.append(price,add);
  content.append(name,desc,tag,bottom);
  card.append(art,content);
  root.append(card);
 });
}

function addCart(id){
 const item=cart.find(x=>x.id===id);
 if(item){
  if(item.qty>=99){alert("Maximum quantity is 99");return}
  item.qty++;
 }else cart.push({id,qty:1});
 saveCart();
 renderCart();
}

function saveCart(){
 try{localStorage.setItem("foodieCart",JSON.stringify(cart))}
 catch(e){console.warn("Unable to save cart")}
}

function cartTotal(){
 return cart.reduce((sum,x)=>{
  const f=foods.find(f=>f.id===x.id);
  return sum+(f?f.price*x.qty:0);
 },0);
}

function renderCart(){
 const root=document.getElementById("cartItems");
 root.replaceChildren();

 document.getElementById("count").textContent=cart.reduce((s,x)=>s+x.qty,0);
 document.getElementById("total").textContent=money(cartTotal());

 if(!cart.length){
  root.innerHTML='<div class="empty"><h3>🛒 Your cart is empty</h3><p>Add your favourite food!</p></div>';
  return;
 }

 cart.forEach(item=>{
  const f=foods.find(x=>x.id===item.id);
  if(!f)return;

  const row=document.createElement("div");
  row.className="cart-item";

  const art=document.createElement("div");
  art.className="mini-art";
  art.style.background=f.bg;
  art.textContent=f.emoji;

  const info=document.createElement("div");
  info.className="item-info";

  const name=document.createElement("h4");
  name.textContent=f.name;

  const price=document.createElement("span");
  price.textContent=money(f.price*item.qty);

  const qty=document.createElement("div");
  qty.className="qty";

  const minus=document.createElement("button");
  minus.textContent="−";
  minus.onclick=()=>{
   if(item.qty>1)item.qty--;
   else cart=cart.filter(x=>x.id!==item.id);
   saveCart();renderCart();
  };

  const number=document.createElement("span");
  number.textContent=item.qty;

  const plus=document.createElement("button");
  plus.textContent="+";
  plus.onclick=()=>{
   if(item.qty<99)item.qty++;
   saveCart();renderCart();
  };

  const remove=document.createElement("button");
  remove.className="remove";
  remove.textContent="Remove";
  remove.onclick=()=>{
   cart=cart.filter(x=>x.id!==item.id);
   saveCart();renderCart();
  };

  qty.append(minus,number,plus);
  info.append(name,price,qty,remove);
  row.append(art,info);
  root.append(row);
 });
}

const cartPanel=document.getElementById("cart");
const overlay=document.getElementById("overlay");
const modal=document.getElementById("modal");

function openCart(){
 cartPanel.classList.add("open");
 overlay.classList.add("show");
}
function closeCart(){
 cartPanel.classList.remove("open");
 overlay.classList.remove("show");
}

document.getElementById("openCart").onclick=openCart;
document.getElementById("closeCart").onclick=closeCart;
overlay.onclick=closeCart;

document.querySelectorAll(".category").forEach(btn=>{
 btn.onclick=()=>{
  document.querySelectorAll(".category").forEach(x=>x.classList.remove("active"));
  btn.classList.add("active");
  category=btn.dataset.cat;
  renderMenu();
 };
});

document.getElementById("search").addEventListener("input",renderMenu);
document.getElementById("clearSearch").onclick=()=>{
 document.getElementById("search").value="";
 renderMenu();
};

document.getElementById("checkout").onclick=()=>{
 if(!cart.length){alert("Please add food to your cart first!");return}
 closeCart();
 document.getElementById("formSection").hidden=false;
 document.getElementById("successSection").hidden=true;
 document.getElementById("checkoutTotal").textContent=money(cartTotal());
 modal.classList.add("show");
};

document.getElementById("closeModal").onclick=()=>modal.classList.remove("show");
modal.addEventListener("click",e=>{
 if(e.target===modal)modal.classList.remove("show");
});

document.getElementById("orderForm").addEventListener("submit",e=>{
 e.preventDefault();

 const name=document.getElementById("customer").value.trim();
 const phone=document.getElementById("phone").value.trim();
 const address=document.getElementById("address").value.trim();
 const payment=document.getElementById("payment").value;

 if(!/^[0-9]{10}$/.test(phone)){
  alert("Please enter a valid 10-digit phone number.");
  return;
 }
 if(!cart.length){alert("Your cart is empty.");return}

 const total=cartTotal();
 const orderId="FD"+Date.now().toString().slice(-8);

 const success=document.getElementById("successSection");
 success.replaceChildren();

 const box=document.createElement("div");
 box.className="success";

 function line(tag,text,className){
  const el=document.createElement(tag);
  el.textContent=text;
  if(className)el.className=className;
  box.appendChild(el);
 }

 line("div","✅","success-icon");
 line("h2","Order Placed Successfully!");
 line("p","Thank you, "+name+"!");
 line("p","Order ID: "+orderId);
 line("p","Phone: "+phone);
 line("p","Address: "+address);
 line("p","Payment: "+payment);
 line("div","Total: "+money(total),"confirmation-total");
 line("p","Your demo order has been saved in this browser.");

 const done=document.createElement("button");
 done.className="submit";
 done.textContent="Continue Shopping";
 done.style.marginTop="18px";
 done.onclick=()=>{
  cart=[];
  saveCart();
  renderCart();
  document.getElementById("orderForm").reset();
  modal.classList.remove("show");
  document.getElementById("formSection").hidden=false;
  success.hidden=true;
 };
 box.appendChild(done);

 success.appendChild(box);
 document.getElementById("formSection").hidden=true;
 success.hidden=false;

 try{
  const orders=JSON.parse(localStorage.getItem("foodieOrders")||"[]");
  const safeOrders=Array.isArray(orders)?orders:[];
  safeOrders.push({
   orderId,name,phone,address,payment,total,
   items:cart.map(x=>({name:foods.find(f=>f.id===x.id).name,qty:x.qty})),
   date:new Date().toLocaleString()
  });
  localStorage.setItem("foodieOrders",JSON.stringify(safeOrders));
 }catch(error){console.warn("Could not save order")}

 cart=[];
 saveCart();
 renderCart();
});

renderMenu();
renderCart();
</script>

</body>
</html>